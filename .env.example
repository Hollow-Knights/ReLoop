# Copy to .env (ignored by Git); fill secrets locally. Never commit .env.
POSTGRES_DB=reloop
POSTGRES_USER=reloop
POSTGRES_PORT=5433
POSTGRES_INIT_TIMEOUT_SECONDS=60
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5433/reloop
DB_USERNAME=reloop
# Must match POSTGRES_PASSWORD for the Compose development database.
DB_PASSWORD=
# Generate locally: openssl rand -base64 32
JWT_SECRET=
# Generate locally: openssl rand -hex 32
IOT_DEVICE_KEY=
IOT_DEVICE_ID=COL-001
PHOTO_BASE_URL=http://localhost:8080
PHOTO_STORAGE_DIR=${HOME}/.local/share/reloop/photos
